      { "navn": "majs-, hirse-, ris- eller boghvedemel", "maengde": 0.25, "enhed": "dl", "afdeling": "kolonial" },
      { "navn": "vand", "maengde": 1, "enhed": "dl", "afdeling": "andet" },
